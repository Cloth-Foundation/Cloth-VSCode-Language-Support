{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Cloth",
  "scopeName": "source.co",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#imports"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#types"
    },
    {
      "include": "#language-variables"
    },
    {
      "include": "#built-in-functions"
    },
    {
      "include": "#member-access"
    },
    {
      "include": "#function-calls"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.cloth",
          "begin": "//",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.cloth"
            }
          },
          "end": "$"
        },
        {
          "name": "comment.block.cloth",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.cloth"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.cloth"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.cloth",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.cloth"
            }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.cloth"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.cloth",
              "match": "\\\\(n|r|t|\\\\|'|\"|0)"
            },
            {
              "name": "invalid.illegal.unknown-escape.cloth",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.cloth",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.cloth"
            }
          },
          "end": "'|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.cloth"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.cloth",
              "match": "\\\\(n|r|t|\\\\|'|\"|0)"
            },
            {
              "name": "invalid.illegal.unknown-escape.cloth",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "imports": {
      "name": "meta.import.cloth",
      "begin": "\\b(import)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.import.cloth"
        }
      },
      "end": ";|$",
      "endCaptures": {
        "0": {
          "name": "punctuation.terminator.statement.cloth"
        }
      },
      "patterns": [
        {
          "name": "keyword.operator.word.alias.cloth",
          "match": "\\bas\\b"
        },
        {
          "name": "entity.name.type.cloth",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        },
        {
          "name": "entity.name.namespace.cloth",
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
        },
        {
          "name": "punctuation.separator.namespace.cloth",
          "match": "::|\\."
        },
        {
          "name": "keyword.operator.wildcard.cloth",
          "match": "\\*"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.declaration.class.inherited.cloth",
          "match": "\\b(class)(\\s*)(:)(\\s*)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.class.cloth"
            },
            "3": {
              "name": "punctuation.separator.type.cloth"
            },
            "5": {
              "name": "entity.other.inherited-class.cloth"
            }
          }
        },
        {
          "name": "meta.function.definition.cloth",
          "match": "\\b(func)(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.cloth"
            },
            "3": {
              "name": "entity.name.function.cloth"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.cloth",
          "match": "\\b(if|else|match)\\b"
        },
        {
          "name": "keyword.control.loop.cloth",
          "match": "\\b(for|while|in|break|continue)\\b"
        },
        {
          "name": "keyword.control.flow.cloth",
          "match": "\\breturn\\b"
        },
        {
          "name": "keyword.declaration.cloth",
          "match": "\\b(func|class|struct|enum|trait)\\b"
        },
        {
          "name": "keyword.other.inheritance.cloth",
          "match": "\\bimplements\\b"
        },
        {
          "name": "storage.type.variable.cloth",
          "match": "\\b(let|var|const)\\b"
        },
        {
          "name": "storage.modifier.cloth",
          "match": "\\b(final|static|override|extern|unsafe)\\b"
        },
        {
          "name": "keyword.control.import.cloth",
          "match": "\\bimport\\b"
        },
        {
          "name": "keyword.other.module.cloth",
          "match": "\\bmodule\\b"
        },
        {
          "name": "keyword.operator.word.cloth",
          "match": "\\b(is|as)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.cloth",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.cloth",
          "match": "\\bnull\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.integer.cloth",
          "match": "\\b(int|int8|int16|int32|int64|uint|uint8|uint16|uint32|uint64|byte)\\b"
        },
        {
          "name": "storage.type.primitive.float.cloth",
          "match": "\\b(float|float32|float64)\\b"
        },
        {
          "name": "storage.type.primitive.boolean.cloth",
          "match": "\\bbool\\b"
        },
        {
          "name": "storage.type.primitive.character.cloth",
          "match": "\\bchar\\b"
        },
        {
          "name": "storage.type.primitive.string.cloth",
          "match": "\\bstring\\b"
        },
        {
          "name": "storage.type.primitive.object.cloth",
          "match": "\\bobject\\b"
        },
        {
          "name": "storage.type.primitive.void.cloth",
          "match": "\\bvoid\\b"
        },
        {
          "name": "entity.name.type.cloth",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "language-variables": {
      "patterns": [
        {
          "name": "variable.language.self.cloth",
          "match": "\\bself\\b"
        },
        {
          "name": "variable.language.super.cloth",
          "match": "\\bsuper\\b"
        }
      ]
    },
    "built-in-functions": {
      "name": "support.function.builtin.cloth",
      "match": "\\b(print|println)\\b(?=\\s*\\()"
    },
    "member-access": {
      "patterns": [
        {
          "name": "meta.member.meta-query.cloth",
          "match": "(::)(length|byteLength|isEmpty|typeName)\\b",
          "captures": {
            "1": {
              "name": "keyword.operator.meta-access.cloth"
            },
            "2": {
              "name": "support.variable.property.meta.cloth"
            }
          }
        },
        {
          "name": "meta.member.meta-query.cloth",
          "match": "(::)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.meta-access.cloth"
            },
            "2": {
              "name": "variable.other.property.cloth"
            }
          }
        },
        {
          "name": "meta.function-call.member.cloth",
          "match": "(\\?\\.|\\.)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "keyword.operator.member-access.cloth"
            },
            "2": {
              "name": "entity.name.function.cloth"
            }
          }
        },
        {
          "name": "meta.member-access.cloth",
          "match": "(\\?\\.|\\.)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.member-access.cloth"
            },
            "2": {
              "name": "variable.other.property.cloth"
            }
          }
        }
      ]
    },
    "function-calls": {
      "name": "entity.name.function.cloth",
      "match": "\\b[a-z_][A-Za-z0-9_]*\\b(?=\\s*\\()"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.cloth",
          "match": "(?<![A-Za-z0-9_])[0-9]+\\.[0-9]+(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.numeric.integer.cloth",
          "match": "(?<![A-Za-z0-9_])[0-9]+(?![A-Za-z0-9_])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.compound.cloth",
          "match": "<<=|>>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^="
        },
        {
          "name": "keyword.operator.bitwise.shift.cloth",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.comparison.cloth",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.cloth",
          "match": "="
        },
        {
          "name": "keyword.operator.logical.cloth",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.nullability.cloth",
          "match": "\\?\\?|\\?\\.|\\?"
        },
        {
          "name": "keyword.operator.increment-decrement.cloth",
          "match": "\\+\\+|--"
        },
        {
          "name": "keyword.operator.arithmetic.cloth",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.bitwise.cloth",
          "match": "&|\\||\\^|~"
        },
        {
          "name": "keyword.operator.meta-access.cloth",
          "match": "::"
        },
        {
          "name": "keyword.operator.member-access.cloth",
          "match": "\\."
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.type.cloth",
          "match": ":"
        },
        {
          "name": "punctuation.separator.delimiter.cloth",
          "match": ","
        },
        {
          "name": "punctuation.terminator.statement.cloth",
          "match": ";"
        },
        {
          "name": "punctuation.section.parens.begin.cloth",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.cloth",
          "match": "\\)"
        },
        {
          "name": "punctuation.section.braces.begin.cloth",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.braces.end.cloth",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.brackets.begin.cloth",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.cloth",
          "match": "\\]"
        }
      ]
    }
  }
}
